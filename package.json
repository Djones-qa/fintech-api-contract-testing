{
  "name": "fintech-api-contract-testing",
  "version": "1.0.0",
  "description": "Consumer-driven contract testing suite for FinTech REST APIs using Pact, Supertest, Zod, and OpenAPI spec compliance",
  "main": "index.js",
  "scripts": {
    "build": "tsc",
    "test": "jest --runInBand",
    "test:consumer": "jest --testPathPattern=consumer --runInBand",
    "test:provider": "jest --testPathPattern=provider --runInBand",
    "test:integration": "jest --testPathPattern=integration --runInBand",
    "test:schema": "jest --testPathPattern=schema --runInBand",
    "test:openapi": "jest --testPathPattern=openapi --runInBand",
    "pact:publish": "ts-node scripts/publish-pacts.ts",
    "pact:can-deploy": "ts-node scripts/can-deploy.ts",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "pact",
    "contract-testing",
    "fintech",
    "supertest",
    "zod",
    "openapi",
    "consumer-driven",
    "microservices",
    "payments",
    "api-testing"
  ],
  "author": {
    "name": "Darrius Jones",
    "url": "https://github.com/darrius-jones"
  },
  "license": "MIT",
  "devDependencies": {
    "@pact-foundation/pact": "^12.1.0",
    "@pact-foundation/pact-node": "^10.18.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "jest": "^29.5.0",
    "supertest": "^6.3.0",
    "ts-jest": "^29.1.0",
    "ts-node": "^10.9.0",
    "typescript": "^5.1.0"
  },
  "dependencies": {
    "express": "^4.18.0",
    "swagger-parser": "^10.0.3",
    "zod": "^3.21.0",
    "axios": "^1.4.0"
  }
}
